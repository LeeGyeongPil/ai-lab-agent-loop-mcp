# 이 파일은 안내용입니다. 값을 바꾸려면 셸에서 환경 변수로 넘기세요.
# 예) AGENT_MODE=mock uv run agent-loop
# API 키는 필요 없습니다. 실제 모드는 내 PC의 Ollama만 씁니다.

# auto(기본) / mock / real
#   auto: Ollama가 켜져 있고 모델이 있으면 real, 아니면 mock
AGENT_MODE=auto

# Ollama 주소와 모델 (도구 호출을 지원하는 모델이어야 합니다. qwen3:4b 외에는 검증하지 않았습니다)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# 컨텍스트 길이. 값을 바꾸면 Ollama가 모델을 다시 적재합니다(10~20초).
OLLAMA_NUM_CTX=8192

# 에이전트 루프 최대 회차 (무한 반복 방지). qwen3:4b는 한 회차에 도구를 하나씩 부르는 일이 많아 예시 ①에 6회차가 걸리기도 한다
AGENT_MAX_STEPS=8

# 웹 포트. 서버는 기본으로 127.0.0.1(내 PC)에만 열립니다(바꾸려면 --host 옵션).
AGENT_PORT=8765

# 모의 모드에서 글자를 흘려 보여 주는 지연(밀리초). 0이면 즉시.
MOCK_DELAY_MS=25

# 연결할 MCP 서버 목록 파일
MCP_SERVERS_FILE=mcp_servers.json
